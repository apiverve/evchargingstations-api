    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "APIVerve",
            "email": "hello@apiverve.com",
            "homepage": "https://apiverve.com"
        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "evchargingstations",
        "ev charging stations api",
        "ev charger api",
        "electric vehicle charging api",
        "charging station locator",
        "nearby ev chargers"
    ],
    "homepage": "https://apiverve.com/marketplace/evchargingstations?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/evchargingstations",
        "source": "https://github.com/apiverve/evchargingstations-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
